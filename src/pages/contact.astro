---
import PageLayout from "@layouts/PageLayout.astro";
import { SITE, SOCIALS, CONTACT } from "@consts";
---

<PageLayout title={CONTACT.TITLE} description={CONTACT.DESCRIPTION}>

  <section style="border-bottom: 2px solid var(--border)">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <div class="py-16 md:py-24">
        <div class="animate">
          <p class="font-sans font-bold text-xs uppercase tracking-widest mb-5 text-accent">
            Get in touch
          </p>
          <h1 class="font-display font-bold text-5xl md:text-6xl leading-none tracking-tight mb-6">
            Say hello.
          </h1>
          <p class="font-serif text-base max-w-md mb-10" style="color: var(--text-muted)">
            Happy to hear from you — whether it's about work, something I've
            written, a project, or just to say hi.
          </p>

          <div class="flex flex-col gap-3 max-w-xs">
            <a href={`mailto:${SITE.EMAIL}`} class="nb-card group flex items-center justify-between p-4">
              <div>
                <div class="font-display font-bold">Email</div>
                <div class="font-sans text-sm" style="color: var(--text-muted)">{SITE.EMAIL}</div>
              </div>
              <span class="font-bold text-accent transition-transform duration-200 group-hover:translate-x-1">→</span>
            </a>

            {SOCIALS.map(social => (
              <a
                href={social.HREF}
                target="_blank"
                rel="noopener noreferrer"
                class="nb-card group flex items-center justify-between p-4"
              >
                <div class="font-display font-bold capitalize">
                  {social.NAME.replace(/-/g, " ")}
                </div>
                <span class="font-bold text-accent transition-transform duration-200 group-hover:translate-x-1">→</span>
              </a>
            ))}
          </div>
        </div>
      </div>
    </div>
  </section>

</PageLayout>
