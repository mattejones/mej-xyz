---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import ArrowCard from "@components/ArrowCard.astro";
import { SITE, HOME } from "@consts";

const blog = (await getCollection("blog"))
  .filter(post => !post.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_POSTS_ON_HOMEPAGE);

const projects = (await getCollection("projects"))
  .filter(project => !project.data.draft)
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, SITE.NUM_PROJECTS_ON_HOMEPAGE);
---

<PageLayout title={HOME.TITLE} description={HOME.DESCRIPTION}>

  <!-- HERO: single-column, dot-grid background -->
  <section class="hero-grid" style="border-bottom: 2px solid var(--border)">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <div class="relative z-10 py-16 md:py-24">
        <div class="animate max-w-xl">
          <p class="font-sans font-bold text-xs uppercase tracking-widest mb-5 text-accent">
            Matt E. Jones
          </p>
          <h1 class="font-display font-bold text-5xl md:text-6xl leading-none tracking-tight mb-6">
            I write and<br />build things.
          </h1>
          <p class="font-serif text-base md:text-lg mb-10" style="color: var(--text-muted)">
            Software engineer from England. I think in public, build in the open,
            and occasionally write something worth reading.
          </p>
          <div class="grid grid-cols-2 gap-3 max-w-xs">
            <a href="/blog" class="nb-card group block p-4">
              <div class="font-display font-bold leading-tight mb-1">Blog</div>
              <div class="font-sans text-xs mb-3" style="color: var(--text-muted)">Notes &amp; ideas</div>
              <div class="font-bold text-accent">→</div>
            </a>
            <a href="/projects" class="nb-card-accent group block p-4">
              <div class="font-display font-bold leading-tight mb-1">Projects</div>
              <div class="font-sans text-xs mb-3" style="color: rgba(255,255,255,0.7)">Things built</div>
              <div class="font-bold text-white">→</div>
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- CONTENT: two-column on desktop -->
  <div class="mx-auto max-w-4xl px-5 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 py-12">

      {blog.length > 0 && (
        <section>
          <div class="animate flex items-center justify-between gap-2 mb-6">
            <h2 class="font-display font-bold text-xl">Recent writing</h2>
            <a href="/blog" class="font-sans font-bold text-xs uppercase tracking-widest text-accent hover:underline">
              All →
            </a>
          </div>
          <ul class="animate flex flex-col gap-3">
            {blog.map(post => <li><ArrowCard entry={post} /></li>)}
          </ul>
        </section>
      )}

      {projects.length > 0 && (
        <section>
          <div class="animate flex items-center justify-between gap-2 mb-6">
            <h2 class="font-display font-bold text-xl">Projects</h2>
            <a href="/projects" class="font-sans font-bold text-xs uppercase tracking-widest text-accent hover:underline">
              All →
            </a>
          </div>
          <ul class="animate flex flex-col gap-3">
            {projects.map(project => <li><ArrowCard entry={project} /></li>)}
          </ul>
        </section>
      )}

    </div>
  </div>

</PageLayout>
