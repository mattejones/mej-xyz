---
import { getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import { dateRange } from "@lib/utils";
import { WORK, SITE, SKILLS, SOCIALS } from "@consts";

const collection = (await getCollection("work"))
  .sort((a, b) => new Date(b.data.dateStart).valueOf() - new Date(a.data.dateStart).valueOf());

const work = await Promise.all(
  collection.map(async (item) => {
    const { Content } = await item.render();
    return { ...item, Content };
  })
);

const current = work[0]?.data;

const personLd = {
  "@context": "https://schema.org",
  "@type": "Person",
  name: SITE.NAME,
  email: `mailto:${SITE.EMAIL}`,
  url: new URL("/work", Astro.site).toString(),
  ...(current && {
    jobTitle: current.role,
    worksFor: { "@type": "Organization", name: current.company },
  }),
  sameAs: SOCIALS.map((s) => s.HREF),
  knowsAbout: SKILLS,
};
---

<PageLayout title={WORK.TITLE} description={WORK.DESCRIPTION}>

  <script type="application/ld+json" set:html={JSON.stringify(personLd)} />

  <!-- Header -->
  <section style="border-bottom: 2px solid var(--border)">
    <div class="mx-auto max-w-4xl px-5 md:px-8">
      <div class="py-14">
        <div class="animate">
          <p class="font-sans font-bold text-xs uppercase tracking-widest mb-4 text-accent">CV</p>
          <h1 class="font-display font-bold text-5xl md:text-6xl leading-none tracking-tight mb-5">
            {SITE.NAME}
          </h1>
          <p class="font-serif text-base max-w-lg" style="color: var(--text-muted)">
            Hello. I'm the person you bring in when you want to solve problems, build with quality, develop a strategic 
            roadmap, improve customer experiences and drive growth. I'm a critical thinker and creative. I bring a 
            positive and caring attituide to my work and those around me. A broad technical generalist who can deep-dive 
            on any topic.
          </p>

          <a
            href="/cv/Matt-Jones-CV.pdf"
            download="Matt-Jones-CV.pdf"
            class="cv-banner nb-card-accent animate mt-8 inline-flex items-center gap-4 px-6 py-4 no-underline"
          >
            <span class="cv-banner-emoji text-3xl" aria-hidden="true">📄</span>
            <span class="flex flex-col">
              <span class="font-sans font-bold text-sm uppercase tracking-widest">Grab the PDF</span>
              <span class="font-serif text-xs opacity-90">No padding. Zero fluff. Download my CV.</span>
            </span>
            <span class="cv-banner-arrow font-sans font-bold text-lg">&darr;</span>
          </a>

          <div class="mt-3">
            <a
              href="/cv/Matt-Jones-CV.md"
              class="font-sans font-semibold text-xs uppercase tracking-widest"
              style="color: var(--text-muted)"
            >
              Plain-text version (Markdown)
            </a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- Two-column: skills + experience -->
  <div class="mx-auto max-w-4xl px-5 md:px-8">
    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 md:gap-12 py-10">

      <!-- Skills sidebar -->
      {SKILLS.length > 0 && (
        <aside>
          <div class="animate">
            <h2 class="font-sans font-bold text-xs uppercase tracking-widest mb-5" style="color: var(--text-muted)">
              Skills &amp; tools
            </h2>
            <div class="flex flex-wrap gap-2">
              {SKILLS.map(skill => (
                <span class="nb-tag">{skill}</span>
              ))}
            </div>
          </div>
        </aside>
      )}

      <!-- Experience (takes up remaining 2 columns) -->
      <section class="md:col-span-2">
        <h2 class="animate font-sans font-bold text-xs uppercase tracking-widest mb-8" style="color: var(--text-muted)">
          Experience
        </h2>
        <ul class="flex flex-col gap-6">
          {work.map(entry => (
            <li class="animate nb-card p-6">
              <div class="flex flex-wrap items-start justify-between gap-3 mb-4">
                <div>
                  <div class="font-display font-bold text-xl leading-tight">{entry.data.company}</div>
                  <div class="font-sans font-semibold text-sm mt-0.5 text-accent">{entry.data.role}</div>
                </div>
                <span class="nb-tag shrink-0">{dateRange(entry.data.dateStart, entry.data.dateEnd)}</span>
              </div>
              <article>
                <entry.Content />
              </article>
            </li>
          ))}
        </ul>
      </section>

    </div>
  </div>

</PageLayout>

<style>
  .cv-banner {
    color: #fff;
    transform: rotate(-1deg);
  }
  .cv-banner:hover {
    transform: rotate(-1deg) translate(2px, 2px);
  }
  .cv-banner-emoji {
    display: inline-block;
    transition: transform 0.2s ease;
  }
  .cv-banner:hover .cv-banner-emoji {
    transform: rotate(-12deg) scale(1.15);
  }
  .cv-banner-arrow {
    transition: transform 0.2s ease;
  }
  .cv-banner:hover .cv-banner-arrow {
    transform: translateY(3px);
  }
</style>
