---
import { type CollectionEntry, getCollection } from "astro:content";
import PageLayout from "@layouts/PageLayout.astro";
import FormattedDate from "@components/FormattedDate.astro";
import { readingTime } from "@lib/utils";
import BackToPrev from "@components/BackToPrev.astro";

export async function getStaticPaths() {
  const posts = (await getCollection("blog"))
    .filter(post => !post.data.draft)
    .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
  return posts.map((post) => ({
    params: { slug: post.slug },
    props: post,
  }));
}
type Props = CollectionEntry<"blog">;

const post = Astro.props;
const { Content } = await post.render();
---

<PageLayout title={post.data.title} description={post.data.description}>
  <div class="mx-auto max-w-4xl px-5 md:px-8">
    <div class="py-10">

      <div class="animate mb-10">
        <BackToPrev href="/blog">Back to blog</BackToPrev>
      </div>

      <div class="animate mb-10 max-w-2xl">
        <div class="flex items-center gap-2 font-sans text-xs uppercase tracking-widest mb-4" style="color: var(--text-muted)">
          <FormattedDate date={post.data.date} />
          <span>&middot;</span>
          <span>{readingTime(post.body)}</span>
        </div>
        <h1 class="font-display font-bold text-3xl md:text-4xl leading-tight">
          {post.data.title}
        </h1>
      </div>

      <!-- Prose capped at readable width, centred within the wider page -->
      <article class="animate max-w-2xl">
        <Content />
      </article>

    </div>
  </div>
</PageLayout>
