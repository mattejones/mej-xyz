---
import Head from "@components/Head.astro";
import Header from "@components/Header.astro";
import Footer from "@components/Footer.astro";
import ScoreTracker from "@components/ScoreTracker.astro";
import MejBadge from "@components/MejBadge.astro";
import { SITE } from "@consts";

type Props = {
  title: string;
  description: string;
};

const { title, description } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <Head title={`${title} | ${SITE.NAME}`} description={description} />
  </head>
  <body>
    <Header />
    <main>
      <slot />
    </main>
    <Footer />
    <ScoreTracker />
    <!-- Badge lives here as a direct body child so position:fixed is always
         viewport-relative (no ancestor transform can interfere). It reads
         #badge-anchor in the header to compute its home position. -->
    <MejBadge />
  </body>
</html>
