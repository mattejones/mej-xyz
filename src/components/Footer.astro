---
import { SITE, SOCIALS } from "@consts";
---

<footer>
  <div class="mx-auto max-w-4xl px-5 md:px-8">
    <div class="flex flex-wrap items-center justify-between gap-4 py-2">
      <div class="font-display font-bold text-sm">
        &copy; 2026 Matt E. Jones
      </div>
      <div class="flex flex-wrap items-center gap-2">
        {SOCIALS.map(s => (
          <a
            href={s.HREF}
            target="_blank"
            rel="noopener noreferrer"
            class="nb-card px-3 py-1.5 font-sans font-bold text-xs uppercase tracking-widest"
          >
            {s.NAME.replace(/-/g, " ")}
          </a>
        ))}
        <!--email_off--><a
          href={`mailto:${SITE.EMAIL}`}
          class="nb-card px-3 py-1.5 font-sans font-bold text-xs uppercase tracking-widest"
        >
          Email
        </a><!--/email_off-->
        <button
          id="color-toggle-button"
          aria-label="Toggle colour mode"
          class="nb-card px-3 py-1.5 font-sans font-bold text-xs uppercase tracking-widest cursor-pointer"
        >
          <span id="color-toggle-label">Colour: on</span>
        </button>
        <!-- 90s mode toggle — locked until score >= 175, wired by Nineties.astro -->
        <button
          id="nineties-toggle-btn"
          aria-label="Toggle 90s mode"
          class="nb-card px-3 py-1.5 font-sans font-bold text-xs uppercase tracking-widest"
          disabled
          title="Unlocks at 175 points"
        >90s: 🔒</button>
        <!-- Snake toggle — locked until score >= 100, homepage only, wired by Snake.astro -->
        <button
          id="snake-play-btn"
          aria-label="Play Snake"
          class="nb-card px-3 py-1.5 font-sans font-bold text-xs uppercase tracking-widest"
          disabled
          title="Unlocks at 100 points"
        >Play 🔒</button>
      </div>
    </div>
  </div>
</footer>
