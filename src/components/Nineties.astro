---
// Nineties.astro — 90s unlockable experience overlay
// Score >= UNLOCK_SCORE unlocks the mode (adds to unlockedModes, shows banner).
// The user must manually enable it via the toggle button in the footer.
// Toggle button rendered by Footer.astro (#nineties-toggle-btn); wired here.
---

<script>
  const STORAGE_KEY  = "mej_score_v1";
  const NINETIES_KEY = "90s";
  const UNLOCK_SCORE = 175; // Level 3

  // ── State helpers ─────────────────────────────────────────────────────

  function loadState(): any {
    try {
      const raw = localStorage.getItem(STORAGE_KEY);
      if (!raw) return { score: 0, unlockedModes: [], activeMode: null };
      return { score: 0, unlockedModes: [] as string[], activeMode: null as string | null, ...JSON.parse(raw) };
    } catch {
      return { score: 0, unlockedModes: [], activeMode: null };
    }
  }

  function saveState(s: any) {
    try { localStorage.setItem(STORAGE_KEY, JSON.stringify(s)); } catch {}
  }

  // ── Toggle button (rendered by Footer.astro) ──────────────────────────

  function updateToggleButton(state: any) {
    const btn = document.getElementById("nineties-toggle-btn") as HTMLButtonElement | null;
    if (!btn) return;

    const unlocked = Array.isArray(state.unlockedModes) && state.unlockedModes.includes(NINETIES_KEY);
    const active   = state.activeMode === NINETIES_KEY;

    if (!unlocked) {
      btn.disabled    = true;
      btn.textContent = "90s: 🔒";
      btn.title       = `Unlocks at ${UNLOCK_SCORE} points`;
      btn.classList.remove("nb-toggle-pressed");
      return;
    }

    btn.disabled    = false;
    btn.title       = active ? "Disable 90s mode" : "Enable 90s mode";
    btn.textContent = active ? "90s: on" : "90s: off";
    active ? btn.classList.add("nb-toggle-pressed") : btn.classList.remove("nb-toggle-pressed");
  }

  function wireToggleButton() {
    const btn = document.getElementById("nineties-toggle-btn");
    if (!btn || btn.dataset.ninetiesWired) return;
    btn.dataset.ninetiesWired = "1";

    btn.addEventListener("click", () => {
      const s     = loadState();
      const wasOn = s.activeMode === NINETIES_KEY;
      s.activeMode = wasOn ? null : NINETIES_KEY;
      saveState(s);
      if (wasOn) {
        removeNinetiesMode(s);
      } else {
        applyNinetiesMode();
        updateToggleButton(s);
      }
    });
  }

  // ── DOM injections ────────────────────────────────────────────────────

  function injectMarquee() {
    if (document.getElementById("nineties-marquee")) return;
    const state      = loadState();
    const visitorNum = String(Math.max(1337, (state.score ?? 0) * 7 + 1337)).padStart(6, "0");
    const el         = document.createElement("div");
    el.id            = "nineties-marquee";
    el.innerHTML =
      `<marquee scrollamount="3">` +
      `★ WELCOME TO MEJ.XYZ ★ LAST UPDATED: TODAY ★ ` +
      `YOU ARE VISITOR NUMBER ${visitorNum} ★ ` +
      `THIS SITE BEST VIEWED IN NETSCAPE NAVIGATOR 4.0 AT 800×600 IN 16-BIT COLOUR ★ ` +
      `POWERED BY JOLT COLA ★ UNDER CONSTRUCTION — CHECK BACK SOON ★ ` +
      `NO UNAUTHORISED DEEP-LINKING ★ FRAMES ARE SUPPORTED ★` +
      `</marquee>`;
    const main = document.querySelector("main");
    if (main) main.insertAdjacentElement("beforebegin", el);
  }

  function injectFooterStrip() {
    if (document.getElementById("nineties-footer")) return;
    const state      = loadState();
    const visitorNum = String(Math.max(1337, (state.score ?? 0) * 7 + 1337)).padStart(6, "0");
    const nobgHref   = window.location.pathname + "?nobg=1";

    const el = document.createElement("div");
    el.id    = "nineties-footer";
    el.innerHTML = `
      <div class="nineties-constbig">
        <img src="/90s/constbig.gif" alt="Under Construction">
      </div>

      <div class="nineties-badges">
        <img src="/90s/best-viewed-eyes.gif" alt="Best viewed with EYES"  title="Best Viewed With EYES">
        <img src="/90s/commnow.gif"           alt="Netscape NOW!"          title="Netscape NOW!">
        <img src="/90s/ie_anim.gif"           alt="Internet Explorer"      title="Get Internet Explorer">
        <img src="/90s/jolt.gif"              alt="Powered by Jolt Cola"   title="This site powered by Jolt Cola">
        <img src="/90s/linux-tux.gif"         alt="Linux"                  title="Linux Inside">
        <img src="/90s/constru2.gif"          alt="Under Construction"     title="Under Construction">
      </div>

      <div class="nineties-counter-row">
        <img src="/90s/typloop.gif"     alt="Typing computer"  class="nineties-typloop">
        <div class="nineties-counter-text">
          <img src="/90s/vcounter.gif"  alt="visitor counter">
          <br>YOU ARE VISITOR #${visitorNum}
        </div>
        <img src="/90s/dancing-aim.gif" alt="Dancing AIM guy"  class="nineties-dancing">
      </div>

      <div class="nineties-disclaimer">
        <span class="blink">★</span>
        THIS PAGE IS BEST VIEWED IN NETSCAPE NAVIGATOR 4.0 AT 800×600 RESOLUTION IN 16-BIT COLOUR
        <span class="blink">★</span>
        <br><br>
        <a href="${nobgHref}" class="nineties-lowbw">
          <img src="/90s/modem.gif" alt="56K Modem">
          [ click here for low-bandwidth / no-background version ]
        </a>
      </div>
    `;

    const footer = document.querySelector("footer");
    if (footer) footer.insertAdjacentElement("afterend", el);
  }

  function replaceHRs() {
    document.querySelectorAll("main hr").forEach(hr => {
      const img     = document.createElement("img");
      img.src       = "/90s/hr-gif-car-line.gif";
      img.alt       = "────────────────────────";
      img.className = "nineties-hr";
      hr.replaceWith(img);
    });
  }

  function injectNewBadges() {
    const now        = Date.now();
    const ninetyDays = 90 * 24 * 60 * 60 * 1000;
    document.querySelectorAll<HTMLElement>("[data-pubdate]").forEach(el => {
      const d = el.getAttribute("data-pubdate");
      if (!d || el.querySelector(".nineties-new")) return;
      if (now - new Date(d).getTime() < ninetyDays) {
        const badge     = document.createElement("img");
        badge.src       = "/90s/newgreen.gif";
        badge.alt       = "NEW!";
        badge.className = "nineties-new";
        el.appendChild(badge);
      }
    });
  }

  function injectMailboxes() {
    document.querySelectorAll<HTMLElement>('a[href^="mailto:"]').forEach(link => {
      if (link.querySelector(".nineties-mailbox")) return;
      const img     = document.createElement("img");
      img.src       = "/90s/mailbox.gif";
      img.alt       = "";
      img.className = "nineties-mailbox";
      link.prepend(img);
    });
  }

  // Replace each <ul> of ArrowCards with a classic HTML table
  function injectCardTables() {
    document.querySelectorAll<HTMLElement>("ul").forEach(ul => {
      // Only target lists that contain ArrowCards
      const cards = Array.from(ul.querySelectorAll<HTMLAnchorElement>(":scope > li > .nb-arrow-card"));
      if (cards.length === 0) return;
      if (ul.classList.contains("nineties-hidden")) return;

      const table  = document.createElement("table");
      table.className = "nineties-table";
      const tbody  = document.createElement("tbody");

      cards.forEach(card => {
        const href    = card.getAttribute("href") ?? "#";
        const title   = card.querySelector(".card-title")?.textContent?.trim() ?? "";
        const desc    = card.querySelector(".card-desc-inner")?.textContent?.trim() ?? "";
        const pubdate = card.getAttribute("data-pubdate") ?? "";
        const dateStr = pubdate
          ? new Date(pubdate).toLocaleDateString("en-GB", { year: "numeric", month: "short" })
          : "";

        const tr      = document.createElement("tr");
        const tdDate  = document.createElement("td");
        const tdTitle = document.createElement("td");
        const tdDesc  = document.createElement("td");

        tdDate.className  = "nineties-table-date";
        tdDate.textContent = dateStr;

        tdTitle.className = "nineties-table-title";
        const a = document.createElement("a");
        a.href        = href;
        a.textContent = title;
        tdTitle.appendChild(a);

        tdDesc.className  = "nineties-table-desc";
        tdDesc.textContent = desc;

        tr.appendChild(tdDate);
        tr.appendChild(tdTitle);
        tr.appendChild(tdDesc);
        tbody.appendChild(tr);
      });

      table.appendChild(tbody);
      ul.classList.add("nineties-hidden");
      ul.insertAdjacentElement("afterend", table);
    });
  }

  // ── Apply / remove mode ───────────────────────────────────────────────

  function applyNinetiesMode() {
    const html = document.documentElement;
    html.setAttribute("data-mode", "90s");

    // Belt-and-suspenders: inline styles ensure the tile renders regardless
    // of CSS specificity fights from other rules or Tailwind's base layer
    document.body.style.setProperty("background-image", "url('/90s/background.png')");
    document.body.style.setProperty("background-repeat", "repeat");
    document.body.style.setProperty("background-color", "#000000");

    // No-background param (?nobg=1)
    if (new URLSearchParams(window.location.search).get("nobg") === "1") {
      html.setAttribute("data-nobg", "true");
      document.body.style.setProperty("background-image", "none");
      document.body.style.setProperty("background-color", "#c0c0c0");
    } else {
      html.removeAttribute("data-nobg");
    }

    injectMarquee();
    injectFooterStrip();
    replaceHRs();
    injectNewBadges();
    injectMailboxes();
    injectCardTables();
  }

  function removeNinetiesMode(state: any) {
    document.documentElement.removeAttribute("data-mode");

    // Remove inline body styles
    document.body.style.removeProperty("background-image");
    document.body.style.removeProperty("background-repeat");
    document.body.style.removeProperty("background-color");

    document.getElementById("nineties-marquee")?.remove();
    document.getElementById("nineties-footer")?.remove();
    document.querySelectorAll(".nineties-mailbox").forEach(el => el.remove());
    document.querySelectorAll(".nineties-new").forEach(el => el.remove());

    // Restore card lists, remove tables
    document.querySelectorAll(".nineties-table").forEach(el => el.remove());
    document.querySelectorAll("ul.nineties-hidden").forEach(ul => ul.classList.remove("nineties-hidden"));

    updateToggleButton(state);
  }

  // ── Unlock announcement — neo-brutalist style ─────────────────────────

  function showUnlockBanner() {
    if (document.getElementById("nineties-unlock-banner")) return;
    const banner = document.createElement("div");
    banner.id    = "nineties-unlock-banner";
    banner.innerHTML = `
      <div class="nineties-unlock-title">🏆 Achievement Unlocked: The 90s Experience</div>
      <div class="nineties-unlock-sub">The 90s toggle is now available in the footer</div>
    `;
    document.body.insertAdjacentElement("afterbegin", banner);
    setTimeout(() => banner.remove(), 5000);
  }

  // ── Entry point ───────────────────────────────────────────────────────

  function initNineties() {
    const state           = loadState();
    const alreadyUnlocked = Array.isArray(state.unlockedModes)
      && state.unlockedModes.includes(NINETIES_KEY);

    // First-time score threshold crossing — unlock but DO NOT auto-activate.
    // User must manually click the footer toggle to enable it.
    if (state.score >= UNLOCK_SCORE && !alreadyUnlocked) {
      if (!Array.isArray(state.unlockedModes)) state.unlockedModes = [];
      state.unlockedModes.push(NINETIES_KEY);
      // Leave activeMode untouched (null) — user opts in via the button
      saveState(state);
      updateToggleButton(state);
      wireToggleButton();
      showUnlockBanner();
      return;
    }

    // Always sync button state and wire it
    updateToggleButton(state);
    wireToggleButton();

    // Apply if the user previously enabled it
    if (state.activeMode === NINETIES_KEY) {
      applyNinetiesMode();
    }
  }

  document.addEventListener("DOMContentLoaded", initNineties);
  document.addEventListener("astro:after-swap",  initNineties);
</script>
