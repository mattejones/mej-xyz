---
// Pass count estimator calculator
---

<div class="not-prose my-8 rounded-lg border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 p-6">
  <p class="text-sm font-sans font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider mb-4">Pass Count Estimator</p>
  <div class="grid grid-cols-2 gap-4 mb-4">
    <div>
      <label class="block text-xs font-sans text-stone-500 dark:text-stone-400 mb-1">N — number of leaves</label>
      <input id="calc-N" type="number" value="150" min="10" max="5000"
        class="w-full rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm font-mono text-stone-800 dark:text-stone-200" />
    </div>
    <div>
      <label class="block text-xs font-sans text-stone-500 dark:text-stone-400 mb-1">f — done threshold (0.05 to 0.50)</label>
      <input id="calc-f" type="number" value="0.35" min="0.05" max="0.50" step="0.05"
        class="w-full rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm font-mono text-stone-800 dark:text-stone-200" />
    </div>
    <div>
      <label class="block text-xs font-sans text-stone-500 dark:text-stone-400 mb-1">c — cuts per pass</label>
      <input id="calc-c" type="number" value="4" min="1" max="20"
        class="w-full rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm font-mono text-stone-800 dark:text-stone-200" />
    </div>
    <div>
      <label class="block text-xs font-sans text-stone-500 dark:text-stone-400 mb-1">r — leaf radius (cm)</label>
      <input id="calc-r" type="number" value="1.75" min="0.5" max="5.0" step="0.25"
        class="w-full rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm font-mono text-stone-800 dark:text-stone-200" />
    </div>
    <div>
      <label class="block text-xs font-sans text-stone-500 dark:text-stone-400 mb-1">Board width (cm)</label>
      <input id="calc-W" type="number" value="40" min="20" max="100"
        class="w-full rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm font-mono text-stone-800 dark:text-stone-200" />
    </div>
    <div>
      <label class="block text-xs font-sans text-stone-500 dark:text-stone-400 mb-1">Board height (cm)</label>
      <input id="calc-H" type="number" value="30" min="15" max="80"
        class="w-full rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm font-mono text-stone-800 dark:text-stone-200" />
    </div>
  </div>
  <div id="calc-result" class="rounded bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-700 p-4 font-mono text-sm text-stone-700 dark:text-stone-300 space-y-1">
    <div id="calc-regime"></div>
    <div id="calc-reff"></div>
    <div id="calc-analytical"></div>
    <div id="calc-pysr"></div>
  </div>
</div>

<script>
  const D_EFF = 0.55;

  function calcK(f: number): number {
    return Math.ceil(Math.log(1 / f) / Math.log(4 / 3));
  }

  function calcTf(f: number): number {
    return calcK(f) / Math.max(2 * f, 1.0);
  }

  function calcReff(N: number, r: number, W: number, H: number) {
    const R_board = Math.min(W, H) / 2 - 1;
    const R_free  = r * Math.sqrt(N / D_EFF);
    return { R_eff: Math.min(R_free, R_board), R_board, R_free };
  }

  function update() {
    const N = parseFloat((document.getElementById("calc-N") as HTMLInputElement).value) || 150;
    const f = parseFloat((document.getElementById("calc-f") as HTMLInputElement).value) || 0.35;
    const c = parseFloat((document.getElementById("calc-c") as HTMLInputElement).value) || 4;
    const r = parseFloat((document.getElementById("calc-r") as HTMLInputElement).value) || 1.75;
    const W = parseFloat((document.getElementById("calc-W") as HTMLInputElement).value) || 40;
    const H = parseFloat((document.getElementById("calc-H") as HTMLInputElement).value) || 30;

    const regime_label = f <= 0.25 ? "fine chop (f <= 0.25)" : "rough chop (f > 0.25)";
    const Ref = calcReff(N, r, W, H);
    const T_f = calcTf(f);
    const logN = Math.log(N);

    const P_analytical = Ref.R_eff * (logN + T_f) / (c * r);
    const P_pysr_fine  = Ref.R_eff * logN / (c * r * (f + 0.185));

    document.getElementById("calc-regime")!.textContent =
      "regime: " + regime_label;
    document.getElementById("calc-reff")!.textContent =
      "R_eff = " + Ref.R_eff.toFixed(1) + " cm  (R_board = " + Ref.R_board.toFixed(1) + ", R_free = " + Ref.R_free.toFixed(1) + ")  |  T_f = " + T_f.toFixed(2) + "  |  k = " + calcK(f);
    document.getElementById("calc-analytical")!.textContent =
      "analytical:  " + P_analytical.toFixed(1) + " passes  (ceiling: " + Math.ceil(P_analytical) + ")";
    document.getElementById("calc-pysr")!.textContent =
      f <= 0.25
        ? "PySR fine:   " + P_pysr_fine.toFixed(1) + " passes  (ceiling: " + Math.ceil(P_pysr_fine) + ")"
        : "PySR fine formula applies for f <= 0.25 only";
  }

  ["calc-N","calc-f","calc-c","calc-r","calc-W","calc-H"].forEach((id) => {
    document.getElementById(id)?.addEventListener("input", update);
  });

  update();
</script>
