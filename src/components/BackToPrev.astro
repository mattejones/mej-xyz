---
type Props = {
  href: string;
}

const { href } = Astro.props;
---

<a href={href} class="nb-card group inline-flex items-center gap-2 px-3 py-1.5 font-sans font-bold text-xs uppercase tracking-widest">
  <svg
    xmlns="http://www.w3.org/2000/svg"
    viewBox="0 0 24 24"
    class="size-3.5 stroke-2 fill-none stroke-current transition-transform duration-200 group-hover:-translate-x-0.5"
  >
    <line x1="19" y1="12" x2="5" y2="12" />
    <polyline points="12 5 5 12 12 19" />
  </svg>
  <slot />
</a>
