---
// Board constraint checker calculator
---

<div class="not-prose my-8 rounded-lg border border-stone-200 dark:border-stone-700 bg-stone-50 dark:bg-stone-800 p-6">
  <p class="text-sm font-sans font-medium text-stone-500 dark:text-stone-400 uppercase tracking-wider mb-4">Board Constraint Checker</p>
  <div class="grid grid-cols-2 gap-4 mb-4">
    <div>
      <label class="block text-xs font-sans text-stone-500 dark:text-stone-400 mb-1">r — leaf radius (cm)</label>
      <input id="bc-r" type="number" value="1.75" min="0.5" max="5.0" step="0.25"
        class="w-full rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm font-mono text-stone-800 dark:text-stone-200" />
    </div>
    <div>
      <label class="block text-xs font-sans text-stone-500 dark:text-stone-400 mb-1">Board short side (cm)</label>
      <input id="bc-H" type="number" value="30" min="15" max="100"
        class="w-full rounded border border-stone-300 dark:border-stone-600 bg-white dark:bg-stone-900 px-3 py-2 text-sm font-mono text-stone-800 dark:text-stone-200" />
    </div>
  </div>
  <div id="bc-result" class="rounded bg-white dark:bg-stone-900 border border-stone-200 dark:border-stone-700 p-4 font-mono text-sm text-stone-700 dark:text-stone-300 space-y-1">
    <div id="bc-rboard"></div>
    <div id="bc-ntrans"></div>
    <div id="bc-note"></div>
  </div>
</div>

<script>
  const D_EFF_BC = 0.55;

  function bcUpdate() {
    const r = parseFloat((document.getElementById("bc-r") as HTMLInputElement).value) || 1.75;
    const H = parseFloat((document.getElementById("bc-H") as HTMLInputElement).value) || 30;

    const R_board = H / 2 - 1;
    const A       = Math.PI * r * r;
    const N_trans = Math.round(Math.PI * R_board * R_board * D_EFF_BC / A);

    document.getElementById("bc-rboard")!.textContent =
      "R_board = " + R_board.toFixed(1) + " cm";
    document.getElementById("bc-ntrans")!.textContent =
      "N_trans = " + N_trans + "  (pile becomes board-constrained above this)";
    document.getElementById("bc-note")!.textContent =
      "N < " + N_trans + ": R_eff = R_free   |   N >= " + N_trans + ": R_eff = R_board = " + R_board.toFixed(1) + " cm";
  }

  ["bc-r", "bc-H"].forEach((id) => {
    document.getElementById(id)?.addEventListener("input", bcUpdate);
  });

  bcUpdate();
</script>
